@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Khách vãng lai\n(Guest)" as Guest
actor "Khách hàng\n(CUSTOMER)" as Customer
actor "Nhân viên\n(STAFF)" as Staff
actor "Quản trị viên\n(ADMIN)" as Admin
actor "System\n(OTP / Mock QR)" as System

rectangle "Hệ thống quản lý kinh doanh ô tô đã qua sử dụng" {
  usecase "UC-01\nXem danh mục xe" as UC01
  usecase "UC-02\nTìm kiếm & lọc xe" as UC02
  usecase "UC-03\nXem chi tiết xe" as UC03
  usecase "UC-04\nĐăng ký tài khoản" as UC04
  usecase "UC-05\nLiên hệ nhanh" as UC05
  usecase "UC-06\nĐăng nhập / Đăng xuất" as UC06
  usecase "UC-07\nQuên mật khẩu" as UC07
  usecase "UC-08\nQuản lý xe yêu thích" as UC08
  usecase "UC-09\nĐặt cọc & hẹn lịch xem xe" as UC09
  usecase "UC-10\nThanh toán cọc giả lập" as UC10
  usecase "UC-11\nXem biên lai & hợp đồng" as UC11
  usecase "UC-12\nXem đơn cọc của tôi" as UC12
  usecase "UC-13\nQuản lý lịch hẹn showroom" as UC13
  usecase "UC-14\nCheck-in khách / lái thử" as UC14
  usecase "UC-15\nHỗ trợ tiếp nhận hoàn cọc" as UC15
  usecase "UC-16\nQuản lý kho xe (CRUD)" as UC16
  usecase "UC-17\nQuản lý tài khoản" as UC17
  usecase "UC-18\nQuản lý ledger & hoàn cọc" as UC18
  usecase "UC-19\nBáo cáo thống kê" as UC19

  usecase "Gửi / xác thực OTP" as OTP
  usecase "Sinh QR / reference giả lập" as QR
}

Guest --> UC01
Guest --> UC02
Guest --> UC03
Guest --> UC04
Guest --> UC05
Guest --> UC06
Guest --> UC07

Customer --> UC06
Customer --> UC07
Customer --> UC08
Customer --> UC09
Customer --> UC10
Customer --> UC11
Customer --> UC12

Staff --> UC13
Staff --> UC14
Staff --> UC15

Admin --> UC16
Admin --> UC17
Admin --> UC18
Admin --> UC19

UC04 .> OTP : <<include>>
UC07 .> OTP : <<include>>
UC09 .> UC10 : <<include>>
UC09 .> UC11 : <<include>>
UC10 --> QR
OTP --> System
QR --> System
@enduml
